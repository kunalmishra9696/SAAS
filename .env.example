# Local development only. Copy this file to .env.local.
# In Cloudflare Pages, set the same values as build-time environment variables.
# Supabase -> Project Settings -> API Keys -> Publishable key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Legacy anon key is supported temporarily if you have not migrated to publishable keys.
# VITE_SUPABASE_ANON_KEY=your_legacy_anon_key

# Never place SUPABASE_SERVICE_ROLE_KEY or any secret key in a VITE_ variable.
